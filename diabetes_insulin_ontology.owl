<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
]>
<rdf:RDF xmlns="http://example.org/diabetes-ontology#"
     xml:base="http://example.org/diabetes-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dbo="http://example.org/diabetes-ontology#">

    <owl:Ontology rdf:about="http://example.org/diabetes-ontology">
        <rdfs:comment>Ontology for OhioT1DM-derived multi-modal insulin dosage prediction (Module 2). Adapted from Pushpavathi &amp; Shunmuganathan (2024).</rdfs:comment>
    </owl:Ontology>

    <!-- ============================ -->
    <!-- Core Classes                  -->
    <!-- ============================ -->

    <owl:Class rdf:about="#Patient">
        <rdfs:comment>A de-identified diabetic patient.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TimeWindow">
        <rdfs:comment>A discrete temporal slice [t-W, t] for GCN graph batching.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Observation">
        <rdfs:comment>Abstract base class for all timestamped events and sensor measurements.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VitalSignObservation">
        <rdfs:subClassOf rdf:resource="#Observation"/>
        <rdfs:comment>Abstract superclass for wearable sensor telemetry.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#GlucoseObservation">
        <rdfs:subClassOf rdf:resource="#Observation"/>
        <rdfs:comment>Covers both CGM and finger-stick (BGM) blood glucose readings in mg/dL.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MealObservation">
        <rdfs:subClassOf rdf:resource="#Observation"/>
        <rdfs:comment>Meal carbohydrate intake event in grams.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SleepObservation">
        <rdfs:subClassOf rdf:resource="#Observation"/>
        <rdfs:comment>Sleep interval state.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ExerciseObservation">
        <rdfs:subClassOf rdf:resource="#Observation"/>
        <rdfs:comment>Physical activity / exercise interval.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#HeartRateObservation">
        <rdfs:subClassOf rdf:resource="#VitalSignObservation"/>
        <rdfs:comment>Continuous heart rate in BPM (OhioT1DM 2018 Basis Peak cohort).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SkinTemperatureObservation">
        <rdfs:subClassOf rdf:resource="#VitalSignObservation"/>
        <rdfs:comment>Wearable skin temperature in degrees Fahrenheit (degF).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AirTemperatureObservation">
        <rdfs:subClassOf rdf:resource="#VitalSignObservation"/>
        <rdfs:comment>Ambient air temperature in degrees Fahrenheit (degF).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#GalvanicSkinResponseObservation">
        <rdfs:subClassOf rdf:resource="#VitalSignObservation"/>
        <rdfs:comment>Galvanic skin response (GSR / skin conductance) in Siemens.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AccelerationObservation">
        <rdfs:subClassOf rdf:resource="#VitalSignObservation"/>
        <rdfs:comment>3-axis accelerometer magnitude in g (OhioT1DM 2020 Empatica Embrace cohort).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#StepObservation">
        <rdfs:subClassOf rdf:resource="#VitalSignObservation"/>
        <rdfs:comment>Interval step count from wearable (OhioT1DM 2018 Basis Peak cohort).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InsulinAdministration">
        <rdfs:subClassOf rdf:resource="#Observation"/>
        <rdfs:comment>Exogenous insulin delivery event or rate from insulin pump.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BasalInsulinAdministration">
        <rdfs:subClassOf rdf:resource="#InsulinAdministration"/>
        <rdfs:comment>Continuous scheduled background basal rate delivery.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TempBasalInsulinAdministration">
        <rdfs:subClassOf rdf:resource="#InsulinAdministration"/>
        <rdfs:comment>Temporary basal rate override with start and end timestamps.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BolusInsulinAdministration">
        <rdfs:subClassOf rdf:resource="#InsulinAdministration"/>
        <rdfs:comment>Discrete bolus insulin dose in Units (U). Prediction TARGET at prediction time t.</rdfs:comment>
    </owl:Class>

    <!-- ============================ -->
    <!-- Object Properties              -->
    <!-- ============================ -->

    <owl:ObjectProperty rdf:about="#hasObservation">
        <rdfs:domain rdf:resource="#TimeWindow"/>
        <rdfs:range rdf:resource="#Observation"/>
        <rdfs:comment>Links a time window container to the observations occurring within it.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasTimeWindow">
        <rdfs:domain rdf:resource="#Patient"/>
        <rdfs:range rdf:resource="#TimeWindow"/>
        <rdfs:comment>Links a patient to their chronological time-window subgraphs.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#temporallyPrecedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="#Observation"/>
        <rdfs:comment>Declarative temporal ordering. In PyG graph construction, sparse sequential nextStep edges are used.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================ -->
    <!-- Datatype Properties            -->
    <!-- ============================ -->

    <!-- Identifiers & Timestamps -->
    <owl:DatatypeProperty rdf:about="#patientId">
        <rdfs:domain rdf:resource="#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>De-identified patient identifier.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#timestamp">
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Event timestamp for the observation.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#windowId">
        <rdfs:domain rdf:resource="#TimeWindow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier for a (patient, time-window) slice.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#windowStart">
        <rdfs:domain rdf:resource="#TimeWindow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Start boundary timestamp of the window.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#windowEnd">
        <rdfs:domain rdf:resource="#TimeWindow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>End boundary timestamp of the window.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Numerical Measurements -->
    <owl:DatatypeProperty rdf:about="#glucoseValue">
        <rdfs:domain rdf:resource="#GlucoseObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Blood glucose reading in mg/dL.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#glucoseSourceType">
        <rdfs:domain rdf:resource="#GlucoseObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Source flag: 'CGM' or 'Fingerstick'.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#carbohydrateAmount">
        <rdfs:domain rdf:resource="#MealObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Meal carbohydrate intake in grams.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#heartRateValue">
        <rdfs:domain rdf:resource="#HeartRateObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Heart rate in BPM.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#skinTemperatureValue">
        <rdfs:domain rdf:resource="#SkinTemperatureObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Skin temperature in degrees Fahrenheit (degF).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#airTemperatureValue">
        <rdfs:domain rdf:resource="#AirTemperatureObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Ambient air temperature in degrees Fahrenheit (degF).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#skinConductanceValue">
        <rdfs:domain rdf:resource="#GalvanicSkinResponseObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Galvanic skin response in Siemens.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#accelerationValue">
        <rdfs:domain rdf:resource="#AccelerationObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>3-axis accelerometer magnitude in g.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#stepCount">
        <rdfs:domain rdf:resource="#StepObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Step count in interval.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#basalRate">
        <rdfs:domain rdf:resource="#BasalInsulinAdministration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Scheduled continuous basal rate in U/hr.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#insulinDose">
        <rdfs:domain rdf:resource="#InsulinAdministration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Insulin dose in Units (U). On BolusInsulinAdministration, this is the prediction target.</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>
